{
  "name": "danvar-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test:preview": "node tools/verify-preview.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write app components content tools/*.mjs lib .agents AGENTS.md *.json *.mjs",
    "format:check": "prettier --check app components content tools/*.mjs lib .agents AGENTS.md *.json *.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "audit:web": "node tools/audit-web.mjs",
    "audit:performance": "npx --yes --package=node@22 node tools/audit-performance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "gsap": "3.15.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lighthouse": "^13.4.1",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
